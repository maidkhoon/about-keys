---
import SiteLayout from "../layouts/SiteLayout.astro";
---
<SiteLayout title="Page not found | About Keys">
  <main class="flex min-h-screen items-center justify-center bg-cream px-6 text-center">
    <div class="max-w-xl">
      <p class="eyebrow text-forest">404 · Page not found</p>
      <h1 class="display-title mt-5 text-5xl sm:text-7xl">Let's find another way.</h1>
      <p class="mt-5 text-sm leading-7 text-black/60">That page isn't part of this demo. Return to the home page to explore the concept.</p>
      <a class="mt-8 inline-flex bg-forest px-6 py-4 text-xs font-bold tracking-wide text-white hover:bg-ink" href="/">BACK TO HOME ↗</a>
    </div>
  </main>
</SiteLayout>
