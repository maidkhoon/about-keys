---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { properties } from "../../data/properties";

export function getStaticPaths() {
  return properties.map((property) => ({
    params: { id: property.id },
    props: { property }
  }));
}

const { property } = Astro.props;
---
<SiteLayout title={`${property.title} | About Keys`} description={`Illustrative property detail concept for ${property.title}.`}>
  <div class="min-h-screen bg-cream">
    <header class="border-b border-black/10">
      <nav class="container-shell flex min-h-[82px] items-center justify-between gap-4">
        <a class="text-sm font-bold tracking-[.22em] text-forest" href="/">ABOUT KEYS</a>
        <a class="text-xs font-bold text-forest" href="/properties/">← ALL PROPERTIES</a>
      </nav>
    </header>
    <main class="container-shell py-12 sm:py-20">
      <p class="eyebrow mb-4 text-forest">Property detail · Demo listing</p>
      <h1 class="display-title max-w-4xl text-4xl leading-tight sm:text-6xl">{property.title}</h1>
      <p class="mt-4 text-sm text-black/60">{property.location} · {property.category}</p>
      <div class="mt-8 grid gap-8 lg:grid-cols-[1.2fr_.8fr]">
        <img class="aspect-[4/3] w-full object-cover" src={property.image} alt={`Illustrative image for ${property.title}`} />
        <div class="self-start border border-black/10 bg-white p-6 sm:p-8">
          <p class="text-xs uppercase tracking-[.15em] text-black/50">Indicative display</p>
          <p class="mt-3 font-display text-3xl">{property.price}</p>
          <p class="mt-5 border-t border-black/10 pt-5 text-sm leading-7 text-black/65">This is a design prototype, not a real or currently available listing. Verified property details, legal status, size, location and price must be supplied and checked before publication.</p>
          <a class="mt-7 inline-flex w-full items-center justify-between bg-forest px-5 py-4 text-xs font-bold tracking-wide text-white hover:bg-ink" href="https://www.instagram.com/about_keys/" target="_blank" rel="noopener noreferrer">ENQUIRE WITH ABOUT KEYS <span>↗</span></a>
        </div>
      </div>
      <div class="mt-8 grid gap-4 border-y border-black/10 py-6 sm:grid-cols-3">
        <div><p class="text-xs text-black/50">Type</p><p class="mt-2 font-semibold">{property.category}</p></div>
        <div><p class="text-xs text-black/50">Area / size</p><p class="mt-2 font-semibold">{property.area}</p></div>
        <div><p class="text-xs text-black/50">Availability</p><p class="mt-2 font-semibold">Not verified</p></div>
      </div>
    </main>
  </div>
</SiteLayout>
