---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}
const { title = "About Keys | Find Your Place in Karnal", description = "Explore the About Keys real estate website concept for discovering homes, plots and commercial properties around Karnal." } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#173d2d" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
