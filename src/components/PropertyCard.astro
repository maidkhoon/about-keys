---
import type { Property } from "../data/properties";

interface Props {
  property: Property;
}
const { property } = Astro.props;
---
<article class="property-card group overflow-hidden rounded-sm border border-black/5 bg-white">
  <a href={`/properties/${property.id}/`} class="block" aria-label={`View ${property.title}`}>
    <div class="relative aspect-[4/3] overflow-hidden bg-sage">
      <img class="property-image h-full w-full object-cover" src={property.image} alt={`Illustrative image for ${property.title}`} loading="lazy" />
      <span class="absolute left-4 top-4 bg-white/95 px-3 py-1.5 text-[10px] font-bold uppercase tracking-[.15em] text-forest">Demo listing</span>
      <span class="absolute bottom-4 right-4 bg-ink/85 px-3 py-2 text-xs text-white">{property.category}</span>
    </div>
    <div class="p-5 sm:p-6">
      <p class="mb-2 text-xs text-black/55">{property.location}</p>
      <h3 class="font-display text-2xl leading-tight group-hover:text-forest">{property.title}</h3>
      <div class="mt-4 flex items-center justify-between gap-3 border-t border-black/10 pt-4">
        <span class="text-sm font-semibold">{property.price}</span>
        <span class="text-xs text-black/55">{property.area}</span>
      </div>
      {property.beds && <p class="mt-3 text-xs text-black/60">{property.beds} bedrooms <span class="mx-2">·</span> {property.baths} bathrooms</p>}
    </div>
  </a>
</article>
